# LLM provider: local Ollama, no API key needed.
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434

# Embeddings also run through Ollama, matching the collaborator's fork so
# retrieval scores are comparable, and so one process manages memory for the
# LLM and the embedder rather than two competing for it.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

# To reproduce the retrieval scores measured before this switch, install
# requirements/huggingface.txt and set:
#   EMBEDDING_PROVIDER=huggingface
#   EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
